<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wakelite.wakereconciler</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/<user>/git/playground/wakelite/bin/wakelite-reconciler</string>
    <string>--interval</string>
    <string>600</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/<user>/.wakelite/logs/reconciler.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/<user>/.wakelite/logs/reconciler.launchd.err.log</string>
</dict>
</plist>
