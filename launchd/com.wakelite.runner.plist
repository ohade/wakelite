<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wakelite.runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/wakelite/bin/wakelite-runner</string>
    <string>--with-mcp-http</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- launchd defaults to 5s, then SIGKILLs. stop() can spend that long just
       joining the scheduler thread before it starts terminating children, and a
       SIGKILL mid-teardown orphans every child (start_new_session=True). -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/path/to/home</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONDONTWRITEBYTECODE</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/path/to/home/.wakelite/logs/runner.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/home/.wakelite/logs/runner.launchd.err.log</string>
</dict>
</plist>
